import PtxReluVJP
import NN.Proofs.Autograd.Tape.Nodes.Reductions

/-! An actual upstream vector multiply/sum/add/ReLU graph. The reverse sweep
is generated by TorchLean; differentiability is point-specific. -/
namespace PtxTorchLean.VectorVJP
open Spec TorchLean Proofs Proofs.Autograd
noncomputable section
set_option maxRecDepth 20000
set_option maxHeartbeats 4000000

abbrev scalar : Shape := .scalar

def inputs (x w : Tensor ℝ s) (b : ℝ) : TensorPack ℝ [s,s,scalar] :=
  .cons x (.cons w (.cons (Tensor.scalar b) .nil))

def rawGraph (s : Shape) : Graph [s,s,scalar] [s,scalar,scalar,scalar] :=
  let x : Idx ([s,s,scalar] ++ []) s := ⟨⟨0,by simp⟩,rfl⟩
  let w : Idx ([s,s,scalar] ++ []) s := ⟨⟨1,by simp⟩,rfl⟩
  let p : Idx ([s,s,scalar] ++ [s]) s := ⟨⟨3,by simp⟩,rfl⟩
  let sum : Idx ([s,s,scalar] ++ [s,scalar]) scalar := ⟨⟨4,by simp⟩,rfl⟩
  let b : Idx ([s,s,scalar] ++ [s,scalar]) scalar := ⟨⟨2,by simp⟩,rfl⟩
  let a : Idx ([s,s,scalar] ++ [s,scalar,scalar]) scalar := ⟨⟨5,by simp⟩,rfl⟩
  (((Graph.nil.snoc (TapeNodes.mul w x)).snoc (TapeNodes.sum p)).snoc
    (TapeNodes.add sum b)).snoc (TapeNodes.relu a)

def output (s : Shape) : Idx ([s,s,scalar] ++ [s,scalar,scalar,scalar]) scalar :=
  ⟨⟨6,by simp⟩,rfl⟩

def graph (s : Shape) : Runtime.Autograd.Torch.TypedGraph ℝ [s,s,scalar] scalar where
  nodeShapes := [s,scalar,scalar,scalar]
  data := (rawGraph s).toAlgebra.toData
  output := output s

def affine (x w : Tensor ℝ s) (b : ℝ) : ℝ :=
  (∑ i, tensorToVec w i * tensorToVec x i) + b

def scale (g : ℝ) (t : Tensor ℝ s) : Tensor ℝ s :=
  vecToTensor (vecOfFun fun i => g * tensorToVec t i)

def sensitivities (x w : Tensor ℝ s) (b d : ℝ) : TensorPack ℝ [s,s,scalar] :=
  inputs (scale (ReluVJP.gate (affine x w b) d) w)
    (scale (ReluVJP.gate (affine x w b) d) x) (ReluVJP.gate (affine x w b) d)

private theorem get_3_0 {s0 s1 s2 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) :
    TorchLean.TensorPack.get (.cons a0 (.cons a1 (.cons a2 .nil))) (0 : Fin 3) = a0 := rfl

private theorem get_3_1 {s0 s1 s2 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) :
    TorchLean.TensorPack.get (.cons a0 (.cons a1 (.cons a2 .nil))) (1 : Fin 3) = a1 := rfl

private theorem get_4_3 {s0 s1 s2 s3 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) :
    TorchLean.TensorPack.get (.cons a0 (.cons a1 (.cons a2 (.cons a3 .nil)))) (3 : Fin 4) = a3 := rfl

private theorem unsnoc_4 {s0 s1 s2 s3 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) :
    TorchLean.TensorPack.unsnoc (ss := [s0, s1, s2]) (.cons a0 (.cons a1 (.cons a2 (.cons a3 .nil)))) = ((.cons a0 (.cons a1 (.cons a2 .nil))),a3) := rfl

private theorem get_5_2 {s0 s1 s2 s3 s4 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) (a4 : Tensor ℝ s4) :
    TorchLean.TensorPack.get (.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 .nil))))) (2 : Fin 5) = a2 := rfl

private theorem get_5_4 {s0 s1 s2 s3 s4 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) (a4 : Tensor ℝ s4) :
    TorchLean.TensorPack.get (.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 .nil))))) (4 : Fin 5) = a4 := rfl

private theorem unsnoc_5 {s0 s1 s2 s3 s4 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) (a4 : Tensor ℝ s4) :
    TorchLean.TensorPack.unsnoc (ss := [s0, s1, s2, s3]) (.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 .nil))))) = ((.cons a0 (.cons a1 (.cons a2 (.cons a3 .nil)))),a4) := rfl

private theorem get_6_5 {s0 s1 s2 s3 s4 s5 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) (a4 : Tensor ℝ s4) (a5 : Tensor ℝ s5) :
    TorchLean.TensorPack.get (.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 (.cons a5 .nil)))))) (5 : Fin 6) = a5 := rfl

private theorem unsnoc_6 {s0 s1 s2 s3 s4 s5 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) (a4 : Tensor ℝ s4) (a5 : Tensor ℝ s5) :
    TorchLean.TensorPack.unsnoc (ss := [s0, s1, s2, s3, s4]) (.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 (.cons a5 .nil)))))) = ((.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 .nil))))),a5) := rfl

private theorem get_7_6 {s0 s1 s2 s3 s4 s5 s6 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) (a4 : Tensor ℝ s4) (a5 : Tensor ℝ s5) (a6 : Tensor ℝ s6) :
    TorchLean.TensorPack.get (.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 (.cons a5 (.cons a6 .nil))))))) (6 : Fin 7) = a6 := rfl

private theorem unsnoc_7 {s0 s1 s2 s3 s4 s5 s6 : Shape} (a0 : Tensor ℝ s0) (a1 : Tensor ℝ s1) (a2 : Tensor ℝ s2) (a3 : Tensor ℝ s3) (a4 : Tensor ℝ s4) (a5 : Tensor ℝ s5) (a6 : Tensor ℝ s6) :
    TorchLean.TensorPack.unsnoc (ss := [s0, s1, s2, s3, s4, s5]) (.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 (.cons a5 (.cons a6 .nil))))))) = ((.cons a0 (.cons a1 (.cons a2 (.cons a3 (.cons a4 (.cons a5 .nil)))))),a6) := rfl

private theorem natAdd_one_ne_zero {n : Nat} (j : Fin n) : Fin.natAdd 1 j ≠ 0 := by
  intro h
  have e := congrArg Fin.val h
  simp at e

private theorem castAdd_zero {n : Nat} [NeZero n] (m : Nat) :
    Fin.castAdd m (0 : Fin n) = 0 := Fin.ext rfl

theorem forward_value (x w : Tensor ℝ s) (b : ℝ) :
    Tensor.item ((graph s).forward (inputs x w b)) = max (affine x w b) 0 := by
  have scalar_coordinate (t : Tensor ℝ scalar) :
      tensorToVec t (⟨0,by decide⟩ : Fin (Shape.size scalar)) = Tensor.item t := by
    conv_lhs => rw [← Tensor.scalar_item t]
    exact tensorToVec_scalar _ _
  rw [← scalar_coordinate]
  simp [graph,inputs,Runtime.Autograd.Torch.TypedGraph.forward,
    Runtime.Autograd.Torch.TypedGraphWithData.forward,rawGraph,Graph.toAlgebra,
    Algebra.Graph.toData,Algebra.GraphData.eval,Node.toAlgebra,
    TapeNodes.relu,TapeNodes.elemwise,TapeNodes.add,TapeNodes.mul,TapeNodes.sum,Node.ofFn,
    output,CtxVec.get_flattenCtx,getIdx,TensorPack.snoc,Tensor.castShape,vecOfFun,
    get_3_0,get_3_1,get_4_3,get_5_2,get_5_4,get_6_5,get_7_6,
    tensorToVec_scalar,TapeNodes.sumCLM_apply,affine]

-- This option concerns shape-indexed elaboration only; kernel checking is unchanged.
set_option backward.isDefEq.respectTransparency false in
theorem generated_vjp (x w : Tensor ℝ s) (b d : ℝ) :
    (graph s).vjpWithSeed (inputs x w b) (Tensor.scalar d) = sensitivities x w b d := by
  simp only [graph,inputs,sensitivities,Runtime.Autograd.Torch.TypedGraph.vjpWithSeed,
    Runtime.Autograd.Torch.TypedGraphWithData.vjpWithSeed,rawGraph,Graph.toAlgebra,
    Algebra.Graph.toData,Algebra.GraphData.backpropCtx,Algebra.GraphData.eval,
    Node.toAlgebra,TapeNodes.relu,TapeNodes.elemwise,TapeNodes.add,TapeNodes.mul,TapeNodes.sum,Node.ofFn,
    output,Algebra.TensorPack.single,TorchLean.TensorPack.cast,TorchLean.TensorPack.zero,
    Tensor.castShape,CtxVec.get_flattenCtx,getIdx,List.nil_append,List.cons_append]
  apply (Function.LeftInverse.injective (fun xs => unflattenCtx_flattenCtx xs))
  apply PiLp.ext
  intro i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · simp [get_3_0,get_3_1,get_4_3,get_5_2,get_5_4,get_6_5,unsnoc_4,unsnoc_5,unsnoc_6,unsnoc_7,
      TorchLean.TensorPack.add,TorchLean.TensorPack.snoc,flattenCtx,unflattenCtx,
      tensorToVec_addSpec,CtxVec.single,CtxVec.singleBlock,appendVec,castVec,Fin.append,
      Fin.addCases,castAdd_zero,natAdd_one_ne_zero,scalar,Shape.size,ctxSize,scale,ReluVJP.gate,affine,TapeNodes.sumCLM_apply,
      Activation.Math.reluDerivSpec,tensorToVec_scalar]
  · refine Fin.addCases (fun k => ?_) (fun k => ?_) j
    · simp [get_3_0,get_3_1,get_4_3,get_5_2,get_5_4,get_6_5,unsnoc_4,unsnoc_5,unsnoc_6,unsnoc_7,
      TorchLean.TensorPack.add,TorchLean.TensorPack.snoc,flattenCtx,unflattenCtx,
      tensorToVec_addSpec,CtxVec.single,CtxVec.singleBlock,appendVec,castVec,Fin.append,
      Fin.addCases,castAdd_zero,natAdd_one_ne_zero,scalar,Shape.size,ctxSize,scale,ReluVJP.gate,affine,TapeNodes.sumCLM_apply,
      Activation.Math.reluDerivSpec,tensorToVec_scalar]
    · have hk : k = ⟨0,by decide⟩ := Fin.eq_zero k
      subst k
      simp [get_3_0,get_3_1,get_4_3,get_5_2,get_5_4,get_6_5,unsnoc_4,unsnoc_5,unsnoc_6,unsnoc_7,
      TorchLean.TensorPack.add,TorchLean.TensorPack.snoc,flattenCtx,unflattenCtx,
      tensorToVec_addSpec,CtxVec.single,CtxVec.singleBlock,appendVec,castVec,Fin.append,
      Fin.addCases,castAdd_zero,natAdd_one_ne_zero,scalar,Shape.size,ctxSize,scale,ReluVJP.gate,affine,TapeNodes.sumCLM_apply,
      Activation.Math.reluDerivSpec,tensorToVec_scalar]

theorem checked_result (x w : Tensor ℝ s) (b d : ℝ) :
    (graph s).vjpChecked (inputs x w b) () (Tensor.scalar d) =
      .ok (sensitivities x w b d, Tensor.scalar (max (affine x w b) 0)) := by
  have success := Runtime.Autograd.Torch.TypedGraphWithData.vjpChecked_eq
    (graph s) (inputs x w b) () (Tensor.scalar d) _ (by rfl)
  have generated := generated_vjp x w b d
  have value : (graph s).forward (inputs x w b) = Tensor.scalar (max (affine x w b) 0) :=
    (Tensor.scalar_item _).symm.trans (congrArg Tensor.scalar (forward_value x w b))
  simp only [Runtime.Autograd.Torch.TypedGraph.vjpWithSeed] at generated
  simp only [Runtime.Autograd.Torch.TypedGraph.forward] at value
  exact success.trans (congrArg Except.ok (Prod.ext generated value))

-- Permit definitional unfolding of the shape-indexed graph while elaborating this proof.
-- This Meta elaborator option does not alter Lean kernel checking.
set_option backward.isDefEq.respectTransparency false in
/-- Every primitive is differentiable at its actual forward input away from the kink. -/
def graph_correct_at (x w : Tensor ℝ s) (b : ℝ) (away : affine x w b ≠ 0) :
    GraphFDerivCorrectAt (rawGraph s) (flattenCtx (inputs x w b)) := by
  unfold rawGraph
  refine ⟨⟨⟨⟨PUnit.unit, (TapeNodes.mulFderiv _ _).at _⟩,
    (TapeNodes.sumFderiv _).at _⟩, (TapeNodes.addFderiv _ _).at _⟩, TapeNodes.reluFderivAt _ _ ?_⟩
  intro i
  have hi : i = ⟨0, by decide⟩ := Fin.eq_zero i
  subst i
  simp only [Graph.evalVec, TapeNodes.add, TapeNodes.mul, TapeNodes.sum, Node.forwardVec_ofFn]
  simpa [snocCtx, CtxVec.get, CtxVec.getBlock, scalar, TapeNodes.sumCLM_apply, affine, Shape.size, ctxSize,
    inputs, flattenCtx, vecOfFun, tensorToVec_scalar, castCtxVec, castVec,
    appendVec, Fin.append, Fin.addCases, castAdd_zero, natAdd_one_ne_zero, EuclideanSpace.equiv, PiLp.continuousLinearEquiv_symm_apply,
    Fin.subNat, Fin.natAdd, Fin.cast, Fin.castAdd, ← Nat.add_assoc] using away

/-- The generated backward is the ordinary mathematical derivative only away from zero. -/
theorem sensitivities_adjoint (x w : Tensor ℝ s) (b d : ℝ) (away : affine x w b ≠ 0) :
    flattenCtx (sensitivities x w b d) =
      (fderiv ℝ (fun v => tensorToVec ((graph s).forward (unflattenCtx v)))
        (flattenCtx (inputs x w b))).adjoint (tensorToVec (Tensor.scalar d)) := by
  rw [← generated_vjp]
  apply Runtime.Autograd.Torch.TypedGraphWithData.vjpWithSeed_adjoint_fderiv
    (graph s) (rawGraph s).toAlgebra rfl (inputs x w b) () (Tensor.scalar d)
  exact (Algebra.Graph.toAlgebra_toReal (rawGraph s) ()).symm ▸ graph_correct_at x w b away


end
end PtxTorchLean.VectorVJP
